{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "www.roberttran.com.au",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/case-files/caitlyn-nails",
      "destination": "/case-files/beek-perfumes/",
      "permanent": true
    },
    {
      "source": "/case-files/pakko-shop",
      "destination": "/case-files/monkey-tribe/",
      "permanent": true
    },
    {
      "source": "/case-files/pakko-quote",
      "destination": "/case-files/porto/",
      "permanent": true
    },
    {
      "source": "/case-files/pakko-idp",
      "destination": "/case-files/ben10hits/",
      "permanent": true
    },
    {
      "source": "/case-files/leartist-wedding",
      "destination": "/case-files/rain-architecture/",
      "permanent": true
    },
    {
      "source": "/case-files/abc-allied-health",
      "destination": "/case-files/rdx-company/",
      "permanent": true
    },
    {
      "source": "/case-files/vn-care",
      "destination": "/case-files/triosis-digital/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/case-files/beek-perfumes",
      "destination": "/case-files/beek-perfumes/index.html"
    },
    {
      "source": "/case-files/beek-perfumes/",
      "destination": "/case-files/beek-perfumes/index.html"
    },
    {
      "source": "/case-files/monkey-tribe",
      "destination": "/case-files/monkey-tribe/index.html"
    },
    {
      "source": "/case-files/monkey-tribe/",
      "destination": "/case-files/monkey-tribe/index.html"
    },
    {
      "source": "/case-files/porto",
      "destination": "/case-files/porto/index.html"
    },
    {
      "source": "/case-files/porto/",
      "destination": "/case-files/porto/index.html"
    },
    {
      "source": "/case-files/ben10hits",
      "destination": "/case-files/ben10hits/index.html"
    },
    {
      "source": "/case-files/ben10hits/",
      "destination": "/case-files/ben10hits/index.html"
    },
    {
      "source": "/case-files/rain-architecture",
      "destination": "/case-files/rain-architecture/index.html"
    },
    {
      "source": "/case-files/rain-architecture/",
      "destination": "/case-files/rain-architecture/index.html"
    },
    {
      "source": "/case-files/rdx-company",
      "destination": "/case-files/rdx-company/index.html"
    },
    {
      "source": "/case-files/rdx-company/",
      "destination": "/case-files/rdx-company/index.html"
    },
    {
      "source": "/case-files/triosis-digital",
      "destination": "/case-files/triosis-digital/index.html"
    },
    {
      "source": "/case-files/triosis-digital/",
      "destination": "/case-files/triosis-digital/index.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/intro.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/intro.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/_next/static/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
